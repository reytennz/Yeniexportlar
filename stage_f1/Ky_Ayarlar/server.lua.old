function showInfobox(element, type, msg, msg2, imgPath, color)
	if isElement(element) then
		triggerClientEvent(element, "showInfobox", element, type, msg, msg2, imgPath, color)
	end
end

----------------------------
-----Arac Dokunulmazlık-----
----------------------------
function AracDokunulmazlik_Modu(source)
if (isPedInVehicle(source ))then
if (isVehicleDamageProof(getPedOccupiedVehicle(source)) == false) then
setVehicleDamageProof(getPedOccupiedVehicle(source), true )
end
end
end
addEvent("AracDokunulmazlik_Event", true )
addEventHandler("AracDokunulmazlik_Event", resourceRoot, AracDokunulmazlik_Modu)

function AracDokunulmazlikKapat_Modu(source)
if (isPedInVehicle (source)) then
setVehicleDamageProof(getPedOccupiedVehicle(source), false )
end
end
addEvent("AracDokunulmazlikKapat_Event", true)
addEventHandler("AracDokunulmazlikKapat_Event", resourceRoot, AracDokunulmazlikKapat_Modu)

--Rainbow
local strbTimer2 = {}
local strbState2 = {}

addEvent("onColor", true)
addEventHandler("onColor", root,
function (sec,fls)
	local vehicle = getPedOccupiedVehicle(source)
	    if isElement(vehicle) then
		    if not(getVehicleOccupant (vehicle, 0 ) == source) then return end
			    if strbState2[vehicle] == true  then
			        if isTimer(strbTimer2[vehicle]) then
                    killTimer(strbTimer2[vehicle])
	                strbTimer2[vehicle] = nil
					strbState2[vehicle] = false
					end
				end					
				strbTimer2[vehicle] = setTimer( 
			function ( vehicle )
				strVariantc ( vehicle,fls )
			end, sec, 0, vehicle )
		strbState2[vehicle] = true
	end	
end)

addEvent("onColorStop", true)
addEventHandler("onColorStop", root,
 function ()	
    local vehicle = getPedOccupiedVehicle(source)
	    if isElement(vehicle) then
            if not(getVehicleOccupant (vehicle, 0 ) == source) then return end
                if strbState2[vehicle] == true then
	                if isTimer(strbTimer2[vehicle]) then
                      killTimer(strbTimer2[vehicle])
	                  strbTimer2[vehicle] = nil
                      strbState2[vehicle] = false
				      setVehicleColor( vehicle, 255, 255, 255 )  
				    end
                 end
		end    		  
end)

function strVariantc ( car,fls)
    if fls == false then 
        if ( getVehicleOverrideLights ( car ) ~= 1 ) then
		  setVehicleColor( car, math.random(0,255), math.random(0,255), math.random(0,255) )
        else	
		  setVehicleColor( car, math.random(0,255), math.random(0,255), math.random(0,255) )	
        end
	elseif fls == true then	
	    if ( getVehicleOverrideLights ( car ) ~= 1 ) then
		  setVehicleColor( car, math.random(0,255), math.random(0,255), math.random(0,255) )
        else	
		  setVehicleColor( car, math.random(0,255), math.random(0,255), math.random(0,255) )	
        end
	end	
end