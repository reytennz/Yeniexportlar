function oyuncu_olurse ()
if ( getElementData(source,"skin:kaydet") == true ) then
local oyuncuskin = getPlayerSkin(source)
setTimer (setPlayerSkin, 4000, 1, source, oyuncuskin)
end
end
addEventHandler("onPlayerWasted", getRootElement(), oyuncu_olurse)

